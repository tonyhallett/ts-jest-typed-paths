{
  "name": "ts-transform-to-module-name-workspace",
  "version": "1.0.0",
  "description": "transforming generic parameter imported type to string path",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:debug": "eslint . --ext .ts,.tsx --debug",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write '**/*.{ts,tsx,js,json,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,json,md}'",
    "build-release-clean": "tsc -b tsconfig.release.json --clean",
    "build-release": "npm run build-release-clean && tsc -b tsconfig.release.json",
    "build-dependencies": "tsc -b tsconfig.dependencies.json",
    "prepack": "npm run check-readmes-generated && npm run test && npm run build-release",
    "generate-jest-readmes": "npm run generate-readmes --workspace=jest-readmes-generator",
    "pack": "ts-node scripts/pack-workspace.ts",
    "prepare": "husky",
    "check-readmes-generated": "npm run check-readmes-generated --workspace=jest-readmes-generator -- --fix-command=\"npm run generate-jest-readmes\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.1",
    "semver": "^7.7.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.53.1"
  },
  "author": "Tony Hallett",
  "license": "ISC",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "lint-staged": {
    "*": [
      "npm run check-readmes-generated"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/semver": "^7.7.1"
  }
}
