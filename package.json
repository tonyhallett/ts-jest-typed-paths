{
  "name": "ts-transform-to-module-name-workspace",
  "version": "1.0.0",
  "description": "transforming generic parameter imported type to string path",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:debug": "eslint . --ext .ts,.tsx --debug",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write '**/*.{ts,tsx,js,json,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,json,md}'",
    "build-installable": "node ./scripts/build-installable-packages.js",
    "build-all": "node ./scripts/build-all.js",
    "prepack": "npm run build-installable",
    "pack": "ts-node --compiler-options \"{\\\"module\\\":\\\"NodeNext\\\",\\\"moduleResolution\\\":\\\"NodeNext\\\",\\\"target\\\":\\\"ES2020\\\",\\\"esModuleInterop\\\":true}\" scripts/pack-workspace.ts",
    "prepare": "husky",
    "test": "npm run test --workspaces --if-present",
    "test-versions": "npm run versions-test --workspace=ts-jest-integration-test",
    "test-complete": "npm run test && npm run test-versions"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.1",
    "semver": "^7.7.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.53.1"
  },
  "author": "Tony Hallett",
  "license": "ISC",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/semver": "^7.7.1"
  }
}
