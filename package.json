{
  "name": "transform-to-path-workspace",
  "version": "1.0.0",
  "description": "transforming generic parameter imported type to string path",
  "private": true,
  "scripts": {
    "clean": " tsc -build tsconfig.build.json --clean",
    "build": "npm run clean && tsc -build tsconfig.build.json",
    "test": "npm run test --workspaces --if-present",
    "prepack": "npm run build",
    "pack": "ts-node --compiler-options \"{\\\"module\\\":\\\"NodeNext\\\",\\\"moduleResolution\\\":\\\"NodeNext\\\",\\\"target\\\":\\\"ES2020\\\",\\\"esModuleInterop\\\":true}\" scripts/pack-workspace.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "prettier": "3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
  "author": "Tony Hallett",
  "license": "ISC",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  }
}
