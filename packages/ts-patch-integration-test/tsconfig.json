{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "__tests__",
    "rootDir": "./src",
    "target": "ES2019",
    "lib": ["ES2019"],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "plugins": [
      {
        "transform": "ts-patch-jest-typed-module-name/transformer"
      }
    ]
  },
  "include": ["./src"],
  "references": [{ "path": "../ts-patch-jest-typed-module-name" }]
}
