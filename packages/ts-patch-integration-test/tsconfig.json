{
  "compilerOptions": {
    "outDir": "__tests__",
    "rootDir": "./src",
    "target": "ES2019",
    "skipLibCheck": true, // important to avoid compiler issues due to @types/node
    "module": "CommonJS",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "plugins": [
      {
        "transform": "ts-patch-jest-typed-module-name/transformer"
      }
    ]
  },
  "include": ["./src"],
  "references": [{ "path": "../ts-patch-jest-typed-module-name" }, { "path": "../test-utils" }]
}
